{
  "functions": {
    "api/machine-readable.js": {
      "includeFiles": "public/machine-readable-base/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\", </llms-full.txt>; rel=\"alternate\"; type=\"text/markdown\", </portfolio.json>; rel=\"alternate\"; type=\"application/json\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/portfolio.json",
      "destination": "/api/machine-readable?format=json"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/machine-readable?format=llms"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/machine-readable?format=llms-full"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
